                  "blocks": {
                    "custom_liquid_D8wWMM": {
                      "type": "custom-liquid",
                      "name": "t:names.custom_liquid",
                      "settings": {
                        "custom_liquid": "<section class=\"ortheon-location-section\">\n  <div class=\"ortheon-location-container\">\n    <h2>Our Location</h2>\n\n    <div class=\"ortheon-location-info\">\n      <div class=\"ortheon-location-row\">\n        <span>📍</span>\n        <p>\n          California State University, Fresno<br>\n          5241 N Maple Ave, Fresno, CA 93740, USA\n        </p>\n      </div>\n\n      <div class=\"ortheon-location-row\">\n        <span>✉️</span>\n        <p>\n          <a href=\"mailto:ortheonposture@gmail.com\">ortheonposture@gmail.com</a>\n        </p>\n      </div>\n\n      <div class=\"ortheon-location-row\">\n        <span>☎️</span>\n        <p>\n          <a href=\"tel:+15595006271\">+1 559 500 6271</a>\n        </p>\n      </div>\n    </div>\n\n    <div class=\"ortheon-map-box\">\n      <iframe\n        src=\"https://www.google.com/maps?q=California%20State%20University%20Fresno%205241%20N%20Maple%20Ave%20Fresno%20CA%2093740%20USA&output=embed\"\n        width=\"100%\"\n        height=\"380\"\n        style=\"border:0;\"\n        allowfullscreen=\"\"\n        loading=\"lazy\">\n      </iframe>\n    </div>\n  </div>\n</section>\n\n<style>\n  .ortheon-location-section {\n    background: #ffffff;\n    padding: 70px 24px;\n  }\n\n  .ortheon-location-container {\n    max-width: 720px;\n    margin: 0 auto;\n  }\n\n  .ortheon-location-container h2 {\n    font-size: clamp(28px, 4vw, 40px);\n    font-weight: 800;\n    color: #111827;\n    margin: 0 0 28px;\n  }\n\n  .ortheon-location-info {\n    display: flex;\n    flex-direction: column;\n    gap: 22px;\n    margin-bottom: 32px;\n  }\n\n  .ortheon-location-row {\n    display: flex;\n    align-items: flex-start;\n    gap: 16px;\n  }\n\n  .ortheon-location-row span {\n    width: 34px;\n    height: 34px;\n    min-width: 34px;\n    border-radius: 50%;\n    background: #e8f4f4;\n    color: #005b5c;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n  }\n\n  .ortheon-location-row p {\n    margin: 0;\n    font-size: 16px;\n    line-height: 1.7;\n    color: #374151;\n  }\n\n  .ortheon-location-row a {\n    color: #005b5c;\n    text-decoration: none;\n    font-weight: 600;\n  }\n\n  .ortheon-map-box {\n    width: 100%;\n    border-radius: 18px;\n    overflow: hidden;\n    border: 1px solid #e5e7eb;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.06);\n  }\n\n  .ortheon-map-box iframe {\n    display: block;\n    width: 100%;\n    height: 380px;\n  }\n\n  @media (max-width: 768px) {\n    .ortheon-location-section {\n      padding: 50px 18px;\n    }\n\n    .ortheon-location-container {\n      max-width: 100%;\n    }\n\n    .ortheon-map-box iframe {\n      height: 320px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .ortheon-location-container h2 {\n      font-size: 28px;\n    }\n\n    .ortheon-location-row p {\n      font-size: 15px;\n    }\n\n    .ortheon-map-box iframe {\n      height: 280px;\n    }\n  }\n</style>"
