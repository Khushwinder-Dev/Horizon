    "custom_liquid_aCjiyi": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<section class=\"ortheon-about-hero\">\n  <div class=\"ortheon-about-hero__content\">\n    <div class=\"ortheon-about-hero__text\">\n      <p class=\"ortheon-about-hero__label\">About Us</p>\n      <h1>Better Posture.<br>Better Life.</h1>\n      <p>\n        At Ortheon, we believe that good posture is the foundation of a healthy,\n        confident life. Our mission is to help you move, feel, and live better every day.\n      </p>\n    </div>\n\n    <div class=\"ortheon-about-hero__image\">\n      <img\n        src=\"https://ortheonposture.com/cdn/shop/files/unnamed_b5a8dbbe-3299-407f-94b0-3dcf3f2f06f1.png\"\n        alt=\"Ortheon posture support\"\n        loading=\"lazy\"\n      >\n    </div>\n  </div>\n</section>\n\n<style>\n  .ortheon-about-hero {\n    background: #005b5c;\n    padding: 56px 28px;\n    color: #ffffff;\n  }\n\n  .ortheon-about-hero__content {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1fr 0.9fr;\n    align-items: center;\n    gap: 60px;\n  }\n\n  .ortheon-about-hero__label {\n    font-size: 18px;\n    margin: 0 0 18px;\n    opacity: 0.95;\n  }\n\n  .ortheon-about-hero h1 {\n    font-size: clamp(42px, 5vw, 72px);\n    line-height: 1.08;\n    margin: 0 0 24px;\n    font-weight: 800;\n    color: #ffffff;\n  }\n\n  .ortheon-about-hero__text > p:last-child {\n    max-width: 520px;\n    font-size: clamp(16px, 1.4vw, 20px);\n    line-height: 1.6;\n    margin: 0;\n    color: #ffffff;\n  }\n\n  .ortheon-about-hero__image img {\n    width: 100%;\n    height: 440px;\n    object-fit: cover;\n    border-radius: 14px;\n    display: block;\n  }\n\n  @media (max-width: 768px) {\n    .ortheon-about-hero {\n      padding: 42px 18px;\n    }\n\n    .ortheon-about-hero__content {\n      grid-template-columns: 1fr;\n      gap: 32px;\n    }\n\n    .ortheon-about-hero h1 {\n      font-size: 42px;\n    }\n\n    .ortheon-about-hero__image img {\n      height: 340px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .ortheon-about-hero h1 {\n      font-size: 34px;\n    }\n\n    .ortheon-about-hero__image img {\n      height: 280px;\n    }\n  }\n</style>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_BCMm4H": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<section class=\"ortheon-story-section\">\n  <div class=\"ortheon-story-container\">\n    \n    <div class=\"ortheon-story-text\">\n      <h2>Our Story</h2>\n\n      <p>\n        Ortheon was born out of a simple idea: posture solutions should be\n        effective, comfortable, and designed for real life.\n      </p>\n\n      <p>\n        After years of research, testing, and collaboration with medical\n        professionals, we created posture support products that combine\n        science, innovation, and everyday comfort.\n      </p>\n\n      <p>\n        Today, thousands of people around the world trust Ortheon to support\n        their posture and improve their quality of life.\n      </p>\n    </div>\n\n    <div class=\"ortheon-story-image\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0740/7668/4444/files/vertical_composition__ultra_realistic__cinematic_202605061114.jpg?v=1778250394\"\n        alt=\"Posture support product\"\n        loading=\"lazy\"\n      >\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .ortheon-story-section {\n    background: #ffffff;\n    padding: 70px 28px;\n  }\n\n  .ortheon-story-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1.1fr 0.9fr;\n    align-items: center;\n    gap: 70px;\n  }\n\n  .ortheon-story-text h2 {\n    font-size: clamp(32px, 4vw, 48px);\n    line-height: 1.1;\n    margin: 0 0 24px;\n    color: #111111;\n    font-weight: 800;\n  }\n\n  .ortheon-story-text p {\n    font-size: 16px;\n    line-height: 1.8;\n    color: #4b5563;\n    margin: 0 0 22px;\n    max-width: 620px;\n  }\n\n  .ortheon-story-text p:last-child {\n    margin-bottom: 0;\n  }\n\n  .ortheon-story-image img {\n    width: 100%;\n    height: 340px;\n    object-fit: cover;\n    object-position: center;\n    border-radius: 14px;\n    display: block;\n  }\n\n  @media (max-width: 768px) {\n    .ortheon-story-section {\n      padding: 50px 18px;\n    }\n\n    .ortheon-story-container {\n      grid-template-columns: 1fr;\n      gap: 32px;\n    }\n\n    .ortheon-story-text h2 {\n      font-size: 34px;\n    }\n\n    .ortheon-story-text p {\n      font-size: 15px;\n      line-height: 1.7;\n    }\n\n    .ortheon-story-image img {\n      height: 300px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .ortheon-story-section {\n      padding: 40px 16px;\n    }\n\n    .ortheon-story-text h2 {\n      font-size: 30px;\n    }\n\n    .ortheon-story-image img {\n      height: 240px;\n      border-radius: 12px;\n    }\n  }\n</style>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_3AJBFL": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<section class=\"ortheon-mission-section\">\n  <div class=\"ortheon-mission-container\">\n\n    <h2 class=\"ortheon-mission-title\">Our Mission</h2>\n\n    <div class=\"ortheon-mission-grid\">\n\n      <div class=\"ortheon-mission-card\">\n        <div class=\"ortheon-mission-icon\">\n          👤\n        </div>\n\n        <h3>Improve Posture</h3>\n\n        <p>\n          Help people build better posture habits for long-term health.\n        </p>\n      </div>\n\n      <div class=\"ortheon-mission-card\">\n        <div class=\"ortheon-mission-icon\">\n          ♡\n        </div>\n\n        <h3>Relieve Pain</h3>\n\n        <p>\n          Reduce neck, back, and shoulder pain caused by poor posture.\n        </p>\n      </div>\n\n      <div class=\"ortheon-mission-card\">\n        <div class=\"ortheon-mission-icon\">\n          🛡\n        </div>\n\n        <h3>Premium Quality</h3>\n\n        <p>\n          Deliver high-quality, durable, and comfortable posture solutions.\n        </p>\n      </div>\n\n      <div class=\"ortheon-mission-card\">\n        <div class=\"ortheon-mission-icon\">\n          👤\n        </div>\n\n        <h3>Empower Lives</h3>\n\n        <p>\n          Enable everyone to live a more active, confident, and pain-free life.\n        </p>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .ortheon-mission-section {\n    padding: 70px 24px;\n    background: #f8f8f8;\n  }\n\n  .ortheon-mission-container {\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  .ortheon-mission-title {\n    text-align: center;\n    font-size: clamp(32px, 4vw, 48px);\n    font-weight: 700;\n    color: #111827;\n    margin: 0 0 50px;\n  }\n\n  .ortheon-mission-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 24px;\n  }\n\n  .ortheon-mission-card {\n    background: #ffffff;\n    border-radius: 18px;\n    padding: 38px 28px;\n    text-align: center;\n    transition: 0.3s ease;\n    box-shadow: 0 4px 18px rgba(0,0,0,0.04);\n  }\n\n  .ortheon-mission-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 10px 30px rgba(0,0,0,0.08);\n  }\n\n  .ortheon-mission-icon {\n    width: 72px;\n    height: 72px;\n    background: #005b5c;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: 0 auto 22px;\n    font-size: 30px;\n    color: #ffffff;\n  }\n\n  .ortheon-mission-card h3 {\n    font-size: 22px;\n    font-weight: 700;\n    color: #111827;\n    margin: 0 0 14px;\n  }\n\n  .ortheon-mission-card p {\n    font-size: 16px;\n    line-height: 1.8;\n    color: #6b7280;\n    margin: 0;\n  }\n\n  @media (max-width: 1024px) {\n    .ortheon-mission-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media (max-width: 768px) {\n    .ortheon-mission-section {\n      padding: 50px 18px;\n    }\n\n    .ortheon-mission-grid {\n      gap: 18px;\n    }\n\n    .ortheon-mission-card {\n      padding: 30px 22px;\n    }\n\n    .ortheon-mission-card h3 {\n      font-size: 20px;\n    }\n\n    .ortheon-mission-card p {\n      font-size: 15px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .ortheon-mission-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .ortheon-mission-title {\n      margin-bottom: 32px;\n    }\n\n    .ortheon-mission-card {\n      padding: 28px 20px;\n    }\n  }\n</style>",
