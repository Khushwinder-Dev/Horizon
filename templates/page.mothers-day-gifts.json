    "custom_liquid_q4thJW": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<section class=\"why-section\">\n  <div class=\"container\">\n    \n    <h2 class=\"section-title\">Why It’s the Perfect Gift for Mom</h2>\n\n    <div class=\"why-grid\">\n\n      <!-- Pain Relief -->\n      <div class=\"why-item\">\n        <div class=\"icon-circle\">\n          <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3a3a3a\" stroke-width=\"1.5\">\n            <path d=\"M12 3v18M8 7c0 2 1 3 4 3s4-1 4-3M8 13c0 2 1 3 4 3s4-1 4-3\"/>\n          </svg>\n        </div>\n        <h4>Pain Relief</h4>\n        <p>Helps relieve back, neck<br>and shoulder pain.</p>\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <!-- Better Posture -->\n      <div class=\"why-item\">\n        <div class=\"icon-circle\">\n          <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3a3a3a\" stroke-width=\"1.5\">\n            <path d=\"M12 2C10 5 10 19 12 22C14 19 14 5 12 2Z\"/>\n          </svg>\n        </div>\n        <h4>Better Posture</h4>\n        <p>Supports natural alignment<br>and improves posture.</p>\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <!-- Daily Comfort -->\n      <div class=\"why-item\">\n        <div class=\"icon-circle\">\n          <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3a3a3a\" stroke-width=\"1.5\">\n            <path d=\"M4 14c6-10 16-10 16-10s0 10-10 16C7 22 4 14 4 14z\"/>\n          </svg>\n        </div>\n        <h4>Daily Comfort</h4>\n        <p>Lightweight, breathable<br>and easy to wear.</p>\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <!-- Doctor Recommended -->\n      <div class=\"why-item\">\n        <div class=\"icon-circle\">\n          <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3a3a3a\" stroke-width=\"1.5\">\n            <path d=\"M12 3l7 4v5c0 5-3.5 9-7 10-3.5-1-7-5-7-10V7l7-4z\"/>\n          </svg>\n        </div>\n        <h4>Doctor Recommended</h4>\n        <p>Trusted by professionals<br>and loved by families.</p>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n.why-section {\n  background: #f7f7f7;\n  padding: 70px 20px;\n  text-align: center;\n}\n\n.container {\n  max-width: 1200px;\n  margin: auto;\n}\n\n.section-title {\n  font-size: 28px;\n  font-weight: 600;\n  margin-bottom: 50px;\n  color: #222;\n}\n\n.why-grid {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n}\n\n.why-item {\n  flex: 1;\n  padding: 0 15px;\n}\n\n.icon-circle {\n  width: 70px;\n  height: 70px;\n  background: #f3e8e4;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0 auto 15px;\n}\n\n.why-item h4 {\n  font-size: 16px;\n  margin-bottom: 8px;\n  font-weight: 600;\n}\n\n.why-item p {\n  font-size: 13px;\n  color: #666;\n  line-height: 1.5;\n}\n\n.divider {\n  width: 1px;\n  height: 80px;\n  background: #ddd;\n}\n\n/* ✅ Tablet */\n@media (max-width: 992px) {\n  .why-grid {\n    flex-wrap: wrap;\n  }\n\n  .divider {\n    display: none;\n  }\n\n  .why-item {\n    flex: 1 1 45%;\n    margin-bottom: 30px;\n  }\n}\n\n/* ✅ Mobile */\n@media (max-width: 600px) {\n  .why-grid {\n    flex-direction: column;\n  }\n\n  .why-item {\n    flex: 100%;\n  }\n\n  .section-title {\n    font-size: 22px;\n  }\n}\n</style>",
