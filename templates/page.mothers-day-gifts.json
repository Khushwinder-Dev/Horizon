    "custom_liquid_An3LWg": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<section class=\"how-section\">\n  <div class=\"container\">\n\n    <h2 class=\"section-title\">How It Works</h2>\n\n    <div class=\"how-grid\">\n\n      <!-- Step 1 -->\n      <div class=\"step\">\n        <div class=\"step-number\">1</div>\n\n        <div class=\"icon-circle\">\n          <!-- Wear Icon -->\n          <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0F4F4F\" stroke-width=\"1.5\">\n            <circle cx=\"12\" cy=\"7\" r=\"3\"/>\n            <path d=\"M6 21v-5a6 6 0 0 1 12 0v5\"/>\n          </svg>\n        </div>\n\n        <div class=\"step-text\">\n          <h4>Wear It</h4>\n          <p>Adjust and wear for<br>a perfect fit.</p>\n        </div>\n      </div>\n\n      <div class=\"arrow\">→</div>\n\n      <!-- Step 2 -->\n      <div class=\"step\">\n        <div class=\"step-number\">2</div>\n\n        <div class=\"icon-circle\">\n          <!-- Spine Icon -->\n          <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0F4F4F\" stroke-width=\"1.5\">\n            <path d=\"M12 2C10 5 10 19 12 22C14 19 14 5 12 2Z\"/>\n          </svg>\n        </div>\n\n        <div class=\"step-text\">\n          <h4>Align Posture</h4>\n          <p>Supports your spine<br>and encourages better posture.</p>\n        </div>\n      </div>\n\n      <div class=\"arrow\">→</div>\n\n      <!-- Step 3 -->\n      <div class=\"step\">\n        <div class=\"step-number\">3</div>\n\n        <div class=\"icon-circle\">\n          <!-- Heart Icon -->\n          <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0F4F4F\" stroke-width=\"1.5\">\n            <path d=\"M12 21s-7-4.5-7-10a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 5.5-7 10-7 10z\"/>\n          </svg>\n        </div>\n\n        <div class=\"step-text\">\n          <h4>Feel the Relief</h4>\n          <p>Experience less pain<br>and more comfort every day.</p>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n.how-section {\n  background: #f7f7f7;\n  padding: 70px 20px;\n  text-align: center;\n}\n\n.container {\n  max-width: 1200px;\n  margin: auto;\n}\n\n.section-title {\n  font-size: 28px;\n  font-weight: 600;\n  margin-bottom: 50px;\n}\n\n.how-grid {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 20px;\n}\n\n.step {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n}\n\n.step-number {\n  width: 40px;\n  height: 40px;\n  background: #0F4F4F;\n  color: #fff;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n}\n\n.icon-circle {\n  width: 70px;\n  height: 70px;\n  background: #eaeaea;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.step-text {\n  text-align: left;\n}\n\n.step-text h4 {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.step-text p {\n  margin: 5px 0 0;\n  font-size: 13px;\n  color: #666;\n}\n\n.arrow {\n  font-size: 24px;\n  color: #aaa;\n}\n\n/* Tablet */\n@media (max-width: 992px) {\n  .how-grid {\n    flex-direction: column;\n  }\n\n  .arrow {\n    display: none;\n  }\n\n  .step {\n    justify-content: center;\n  }\n}\n\n/* Mobile */\n@media (max-width: 600px) {\n  .step {\n    flex-direction: column;\n    text-align: center;\n  }\n\n  .step-text {\n    text-align: center;\n  }\n}\n</style>",
