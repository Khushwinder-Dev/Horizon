ize: 16px;\n  margin-bottom: 8px;\n  font-weight: 600;\n}\n\n.why-item p {\n  font-size: 13px;\n  color: #666;\n  line-height: 1.5;\n}\n\n.divider {\n  width: 1px;\n  height: 80px;\n  background: #ddd;\n}\n\n/* ✅ Tablet */\n@media (max-width: 992px) {\n  .why-grid {\n    flex-wrap: wrap;\n  }\n\n  .divider {\n    display: none;\n  }\n\n  .why-item {\n    flex: 1 1 45%;\n    margin-bottom: 30px;\n  }\n}\n\n/* ✅ Mobile */\n@media (max-width: 600px) {\n  .why-grid {\n    flex-direction: column;\n  }\n\n  .why-item {\n    flex: 100%;\n  }\n\n  .section-title {\n    font-size: 22px;\n  }\n}\n</style>",
