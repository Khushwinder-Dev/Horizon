    "custom_liquid_TL7YtH": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<section class=\"testimonial-section\">\n  <div class=\"container\">\n\n    <h2 class=\"section-title\">Loved by Moms</h2>\n    <p class=\"section-sub\">Real stories from real people.</p>\n\n    <div class=\"testimonial-wrapper\">\n\n      <button class=\"nav prev\">&#10094;</button>\n\n      <div class=\"testimonial-track\" id=\"slider\">\n\n        <!-- Card 1 -->\n        <div class=\"testimonial-card\">\n          <div class=\"stars\">★★★★★</div>\n          <p>\"I bought this for my mom and she absolutely loves it. Her back pain has reduced so much!\"</p>\n\n          <div class=\"user\">\n            <img src=\"https://i.pravatar.cc/60?img=1\">\n            <div>\n              <strong>Jessica M.</strong><br>\n              <span>Verified Buyer</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- Card 2 -->\n        <div class=\"testimonial-card\">\n          <div class=\"stars\">★★★★★</div>\n          <p>\"The posture corrector is so comfortable and easy to wear. Highly recommend!\"</p>\n\n          <div class=\"user\">\n            <img src=\"https://i.pravatar.cc/60?img=2\">\n            <div>\n              <strong>Sophia R.</strong><br>\n              <span>Verified Buyer</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- Card 3 -->\n        <div class=\"testimonial-card\">\n          <div class=\"stars\">★★★★★</div>\n          <p>\"Great quality and it really works. My mom feels more confident and active now.\"</p>\n\n          <div class=\"user\">\n            <img src=\"https://i.pravatar.cc/60?img=3\">\n            <div>\n              <strong>Emily T.</strong><br>\n              <span>Verified Buyer</span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <button class=\"nav next\">&#10095;</button>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n.testimonial-section {\n  padding: 80px 20px;\n  background: #f9f9f9;\n  text-align: center;\n}\n\n.container {\n  max-width: 1200px;\n  margin: auto;\n}\n\n.section-title {\n  font-size: 28px;\n  font-weight: 600;\n}\n\n.section-sub {\n  color: #777;\n  margin-bottom: 40px;\n}\n\n.testimonial-wrapper {\n  position: relative;\n  display: flex;\n  align-items: center;\n}\n\n.testimonial-track {\n  display: flex;\n  gap: 20px;\n  overflow: hidden;\n  scroll-behavior: smooth;\n}\n\n.testimonial-card {\n  min-width: 320px;\n  background: #fff;\n  padding: 25px;\n  border-radius: 16px;\n  text-align: left;\n  box-shadow: 0 5px 20px rgba(0,0,0,0.05);\n}\n\n.stars {\n  color: #f5a623;\n  margin-bottom: 10px;\n}\n\n.testimonial-card p {\n  font-size: 14px;\n  color: #555;\n  margin-bottom: 20px;\n}\n\n.user {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.user img {\n  width: 45px;\n  height: 45px;\n  border-radius: 50%;\n}\n\n.user span {\n  font-size: 12px;\n  color: #888;\n}\n\n/* Arrows */\n.nav {\n  background: #fff;\n  border: none;\n  font-size: 24px;\n  cursor: pointer;\n  padding: 10px;\n}\n\n/* Responsive */\n@media(max-width: 768px){\n  .testimonial-track {\n    overflow-x: auto;\n  }\n}\n</style>\n\n<script>\nconst slider = document.getElementById('slider');\n\ndocument.querySelector('.next').onclick = () => {\n  slider.scrollBy({ left: 340, behavior: 'smooth' });\n};\n\ndocument.querySelector('.prev').onclick = () => {\n  slider.scrollBy({ left: -340, behavior: 'smooth' });\n};\n</script>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
