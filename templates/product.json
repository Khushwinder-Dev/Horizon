        "custom_liquid": "<section class=\"ortheon-trust-carousel\">\n  <div class=\"ortheon-trust-track\">\n\n    <div class=\"ortheon-trust-item\">\n      <div class=\"ortheon-trust-icon\">🛡️</div>\n      <div>\n        <h3>Secure Payments</h3>\n        <p>100% safe checkout</p>\n      </div>\n    </div>\n\n    <div class=\"ortheon-trust-item\">\n      <div class=\"ortheon-trust-icon\">🚚</div>\n      <div>\n        <h3>Fast Shipping</h3>\n        <p>Quick delivery worldwide</p>\n      </div>\n    </div>\n\n    <div class=\"ortheon-trust-item\">\n      <div class=\"ortheon-trust-icon\">↻</div>\n      <div>\n        <h3>Easy Returns</h3>\n        <p>30-day hassle-free returns</p>\n      </div>\n    </div>\n\n    <div class=\"ortheon-trust-item\">\n      <div class=\"ortheon-trust-icon\">🏅</div>\n      <div>\n        <h3>Premium Quality</h3>\n        <p>Designed for daily comfort</p>\n      </div>\n    </div>\n\n    <div class=\"ortheon-trust-item\">\n      <div class=\"ortheon-trust-icon\">💳</div>\n      <div>\n        <h3>Secure Checkout</h3>\n        <p>Encrypted payment protection</p>\n      </div>\n    </div>\n\n    <div class=\"ortheon-trust-item\">\n      <div class=\"ortheon-trust-icon\">⭐</div>\n      <div>\n        <h3>Trusted by Thousands</h3>\n        <p>Loved by customers worldwide</p>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .ortheon-trust-carousel {\n    background: #ffffff;\n    padding: 18px 0;\n    overflow: hidden;\n    border-top: 1px solid #edf2f2;\n    border-bottom: 1px solid #edf2f2;\n  }\n\n  .ortheon-trust-track {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n    overflow-x: auto;\n    scroll-behavior: smooth;\n    padding: 0 18px;\n\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  .ortheon-trust-track::-webkit-scrollbar {\n    display: none;\n  }\n\n  .ortheon-trust-item {\n    min-width: 260px;\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    background: #f8fbfb;\n    border: 1px solid #e4eeee;\n    border-radius: 14px;\n    padding: 14px 18px;\n    flex-shrink: 0;\n  }\n\n  .ortheon-trust-icon {\n    width: 52px;\n    height: 52px;\n    min-width: 52px;\n    border-radius: 50%;\n    background: #005b5c;\n    color: #ffffff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 22px;\n  }\n\n  .ortheon-trust-item h3 {\n    margin: 0 0 3px;\n    font-size: 16px;\n    line-height: 1.2;\n    font-weight: 800;\n    color: #111827;\n  }\n\n  .ortheon-trust-item p {\n    margin: 0;\n    font-size: 13px;\n    color: #6b7280;\n    line-height: 1.4;\n  }\n\n  @media (max-width: 768px) {\n    .ortheon-trust-item {\n      min-width: 220px;\n      padding: 12px 14px;\n    }\n\n    .ortheon-trust-icon {\n      width: 46px;\n      height: 46px;\n      min-width: 46px;\n      font-size: 20px;\n    }\n\n    .ortheon-trust-item h3 {\n      font-size: 15px;\n    }\n\n    .ortheon-trust-item p {\n      font-size: 12px;\n    }\n  }\n</style>",
