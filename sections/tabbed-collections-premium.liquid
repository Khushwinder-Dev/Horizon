{%- comment -%}
  Tabbed Collections Premium
  Custom Section for Horizon Theme
{%- endcomment -%}

{%- style -%}
  /* Scoped CSS for Tabbed Collections Premium */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .tcp-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    font-family: inherit;
  }

  .tcp-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .tcp-heading {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 600;
    color: #111;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  /* Tabs Navigation */
  .tcp-tabs {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 12px;
    margin-bottom: 3rem;
    overflow-x: auto;
    padding-bottom: 15px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }
  @media screen and (min-width: 768px) {
    .tcp-tabs {
      justify-content: center;
    }
  }
  .tcp-tabs::-webkit-scrollbar {
    display: none;
  }

  .tcp-tab-btn {
    appearance: none;
    background: #f4f4f5;
    border: 1px solid transparent;
    border-radius: 9999px;
    padding: 12px 28px;
    font-size: 14px;
    font-weight: 500;
    color: #52525b;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    scroll-snap-align: center;
  }

  .tcp-tab-btn:hover {
    background: #e4e4e7;
    color: #18181b;
  }

  .tcp-tab-btn.is-active {
    background: linear-gradient(135deg, #18181b 0%, #27272a 100%);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    transform: scale(1.02);
  }

  /* Content Area */
  .tcp-content-wrapper {
    position: relative;
    min-height: 400px;
  }

  .tcp-panel {
    display: none;
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .tcp-panel.is-active {
    display: block;
  }

  .tcp-panel.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Grid Layout */
  .tcp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media screen and (min-width: 768px) {
    .tcp-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media screen and (min-width: 1024px) {
    .tcp-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }
  }

  /* Product Card */
  .tcp-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    border: 1px solid rgba(0,0,0,0.04);
  }

  .tcp-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .tcp-card-image-wrap {
    position: relative;
    overflow: hidden;
    padding-top: 100%; /* 1:1 Aspect Ratio */
    background-color: #fafafa;
    border-radius: 16px 16px 0 0;
  }

  .tcp-card-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .tcp-card:hover .tcp-card-image {
    transform: scale(1.06);
  }

  .tcp-card-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .tcp-card-title {
    font-size: 15px;
    font-weight: 600;
    color: #18181b;
    margin: 0 0 8px 0;
    text-decoration: none;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tcp-card-title:hover {
    color: #52525b;
  }

  .tcp-card-prices {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .tcp-price-current {
    font-size: 15px;
    font-weight: 600;
    color: #18181b;
  }

  .tcp-price-compare {
    font-size: 13px;
    color: #a1a1aa;
    text-decoration: line-through;
  }

  /* Add to Cart Button */
  .tcp-add-btn {
    margin-top: auto;
    width: 100%;
    background: transparent;
    color: #18181b;
    border: 1px solid #e4e4e7;
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .tcp-add-btn:hover:not(:disabled) {
    background: #18181b;
    color: #ffffff;
    border-color: #18181b;
  }

  .tcp-add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: #f4f4f5;
  }

  .tcp-add-btn.is-loading {
    color: transparent;
    position: relative;
  }

  .tcp-add-btn.is-loading::after {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid #fff;
    border-top-color: transparent;
    border-radius: 50%;
    animation: tcp-spin 0.6s linear infinite;
  }
  
  .tcp-add-btn.is-loading:not(:hover)::after {
    border: 2px solid #18181b;
    border-top-color: transparent;
  }

  @keyframes tcp-spin {
    to { transform: rotate(360deg); }
  }

  /* View All Button */
  .tcp-view-all {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .tcp-view-all-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: 15px;
    font-weight: 500;
    color: #18181b;
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .tcp-view-all-link:hover {
    border-color: #18181b;
    box-shadow: 0 4px 14px rgba(0,0,0,0.05);
  }

  /* Skeleton Loader */
  .tcp-loader {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 2;
    background: {{ section.settings.background_color }};
  }

  .tcp-loader.is-active {
    display: block;
  }

  .tcp-skeleton {
    background: #fff;
    border-radius: 16px;
    border: 1px solid rgba(0,0,0,0.04);
    overflow: hidden;
    height: 100%;
  }

  .tcp-skeleton-img {
    width: 100%;
    padding-top: 100%;
    background: linear-gradient(90deg, #f4f4f5 25%, #e4e4e7 50%, #f4f4f5 75%);
    background-size: 200% 100%;
    animation: tcp-shimmer 1.5s infinite;
  }

  .tcp-skeleton-info {
    padding: 20px;
  }

  .tcp-skeleton-text {
    height: 16px;
    background: linear-gradient(90deg, #f4f4f5 25%, #e4e4e7 50%, #f4f4f5 75%);
    background-size: 200% 100%;
    animation: tcp-shimmer 1.5s infinite;
    border-radius: 4px;
    margin-bottom: 12px;
  }

  .tcp-skeleton-text.short {
    width: 60%;
    margin-bottom: 24px;
  }

  .tcp-skeleton-btn {
    height: 42px;
    background: linear-gradient(90deg, #f4f4f5 25%, #e4e4e7 50%, #f4f4f5 75%);
    background-size: 200% 100%;
    animation: tcp-shimmer 1.5s infinite;
    border-radius: 8px;
  }

  @keyframes tcp-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="tcp-container">
    {%- if section.settings.heading != blank -%}
      <div class="tcp-header">
        <h2 class="tcp-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="tcp-tabs" role="tablist" aria-label="Collections">
      {%- for i in (1..3) -%}
        {%- assign collection_id = 'collection_' | append: i -%}
        {%- assign tab_label_id = 'tab_label_' | append: i -%}
        {%- assign collection = collections[section.settings[collection_id]] -%}
        {%- assign tab_label = section.settings[tab_label_id] -%}
        
        {%- if collection != blank or tab_label != blank -%}
          <button 
            type="button" 
            class="tcp-tab-btn{% if forloop.first %} is-active{% endif %}" 
            role="tab" 
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" 
            aria-controls="tcp-panel-{{ section.id }}-{{ i }}" 
            id="tcp-tab-{{ section.id }}-{{ i }}" 
            data-target="tcp-panel-{{ section.id }}-{{ i }}"
          >
            {{ tab_label | default: collection.title | default: 'Collection' }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="tcp-content-wrapper">
      {%- comment -%} Skeleton Loader {%- endcomment -%}
      <div class="tcp-loader" id="tcp-loader-{{ section.id }}">
        <div class="tcp-grid">
          {%- for i in (1..4) -%}
            <div class="tcp-skeleton">
              <div class="tcp-skeleton-img"></div>
              <div class="tcp-skeleton-info">
                <div class="tcp-skeleton-text"></div>
                <div class="tcp-skeleton-text short"></div>
                <div class="tcp-skeleton-btn"></div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- for i in (1..3) -%}
        {%- assign collection_id = 'collection_' | append: i -%}
        {%- assign collection = collections[section.settings[collection_id]] -%}
        
        <div 
          id="tcp-panel-{{ section.id }}-{{ i }}" 
          class="tcp-panel{% if forloop.first %} is-active is-visible{% endif %}" 
          role="tabpanel" 
          aria-labelledby="tcp-tab-{{ section.id }}-{{ i }}"
        >
          <div class="tcp-grid">
            {%- if collection != blank and collection.products_count > 0 -%}
              {%- for product in collection.products limit: 8 -%}
                <div class="tcp-card">
                  <a href="{{ product.url }}" class="tcp-card-image-wrap">
                    {%- if product.featured_media -%}
                      <img 
                        srcset="{%- if product.featured_media.width >= 165 -%}{{ product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                          {%- if product.featured_media.width >= 360 -%}{{ product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                          {%- if product.featured_media.width >= 533 -%}{{ product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                          {%- if product.featured_media.width >= 720 -%}{{ product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                          {%- if product.featured_media.width >= 940 -%}{{ product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                          {{ product.featured_media | image_url }} {{ product.featured_media.width }}w"
                        src="{{ product.featured_media | image_url: width: 533 }}"
                        sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                        alt="{{ product.featured_media.alt | escape }}"
                        class="tcp-card-image"
                        loading="lazy"
                        width="{{ product.featured_media.width }}"
                        height="{{ product.featured_media.height }}"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'tcp-card-image' }}
                    {%- endif -%}
                  </a>
                  <div class="tcp-card-info">
                    <a href="{{ product.url }}" class="tcp-card-title">{{ product.title | escape }}</a>
                    <div class="tcp-card-prices">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="tcp-price-current">{{ product.price | money }}</span>
                        <span class="tcp-price-compare">{{ product.compare_at_price | money }}</span>
                      {%- else -%}
                        <span class="tcp-price-current">{{ product.price | money }}</span>
                      {%- endif -%}
                    </div>
                    
                    {%- if product.available -%}
                      <form method="post" action="/cart/add" class="tcp-add-to-cart-form" accept-charset="UTF-8" enctype="multipart/form-data">
                        <input type="hidden" name="form_type" value="product">
                        <input type="hidden" name="utf8" value="✓">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <button type="submit" name="add" class="tcp-add-btn">
                          {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
                        </button>
                      </form>
                    {%- else -%}
                      <button class="tcp-add-btn" disabled>
                        {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
                      </button>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- for j in (1..4) -%}
                <div class="tcp-card">
                  <div class="tcp-card-image-wrap">
                    {{ 'product-' | append: j | placeholder_svg_tag: 'tcp-card-image' }}
                  </div>
                  <div class="tcp-card-info">
                    <span class="tcp-card-title">Example Product Title</span>
                    <div class="tcp-card-prices">
                      <span class="tcp-price-current">$99.00</span>
                    </div>
                    <button class="tcp-add-btn" disabled>Add to Cart</button>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
          
          {%- if collection != blank and collection.all_products_count > 8 -%}
            <div class="tcp-view-all">
              <a href="{{ collection.url }}" class="tcp-view-all-link">
                {{ 'sections.collection_list.view_all' | t | default: 'View all products' }}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const tabs = section.querySelectorAll('.tcp-tab-btn');
    const panels = section.querySelectorAll('.tcp-panel');
    const loader = section.querySelector('#tcp-loader-{{ section.id }}');
    const forms = section.querySelectorAll('.tcp-add-to-cart-form');

    // Tab Switching Logic
    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        const targetId = tab.getAttribute('data-target');
        const activeTab = section.querySelector('.tcp-tab-btn.is-active');
        const activePanel = section.querySelector('.tcp-panel.is-active');
        
        if (activeTab === tab) return;

        // Update Tabs
        if (activeTab) {
          activeTab.classList.remove('is-active');
          activeTab.setAttribute('aria-selected', 'false');
        }
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        // Transition Panels
        if (activePanel) {
          activePanel.classList.remove('is-visible');
          
          // Wait for fade out
          setTimeout(() => {
            activePanel.classList.remove('is-active');
            
            // Show Loader momentarily for premium feel
            if (loader) {
              loader.classList.add('is-active');
              
              setTimeout(() => {
                loader.classList.remove('is-active');
                const newPanel = section.querySelector(`#${targetId}`);
                if (newPanel) {
                  newPanel.classList.add('is-active');
                  // Trigger reflow
                  void newPanel.offsetWidth;
                  newPanel.classList.add('is-visible');
                }
              }, 400); // Loader duration
            } else {
              const newPanel = section.querySelector(`#${targetId}`);
              if (newPanel) {
                newPanel.classList.add('is-active');
                void newPanel.offsetWidth;
                newPanel.classList.add('is-visible');
              }
            }
          }, 400); // Fade out duration
        }
      });
    });

    // AJAX Add to Cart Logic (Minimal Vanilla JS)
    forms.forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const formData = new FormData(form);
        
        // Setup Loading State
        submitBtn.classList.add('is-loading');
        submitBtn.disabled = true;

        try {
          const response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          });
          
          if (!response.ok) throw new Error('Network response was not ok');
          
          // Success Feedback
          submitBtn.classList.remove('is-loading');
          const originalText = submitBtn.textContent;
          submitBtn.textContent = 'Added!';
          
          // Dispatch cart update event for standard Shopify themes
          document.dispatchEvent(new CustomEvent('cart:updated'));
          document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));

          // Reset button after 2s
          setTimeout(() => {
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
          }, 2000);
          
        } catch (error) {
          console.error('Error adding to cart:', error);
          submitBtn.classList.remove('is-loading');
          submitBtn.disabled = false;
          alert('There was an error adding this item to your cart.');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Tabbed Collections",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Premium Collections"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Tab 1 Settings"
    },
    {
      "type": "text",
      "id": "tab_label_1",
      "label": "Tab 1 Label",
      "default": "Essential Collection (Beginner)"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Select Collection 1"
    },
    {
      "type": "header",
      "content": "Tab 2 Settings"
    },
    {
      "type": "text",
      "id": "tab_label_2",
      "label": "Tab 2 Label",
      "default": "Pro Collection (Mid-Level)"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Select Collection 2"
    },
    {
      "type": "header",
      "content": "Tab 3 Settings"
    },
    {
      "type": "text",
      "id": "tab_label_3",
      "label": "Tab 3 Label",
      "default": "Premium Collection (High-End)"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Select Collection 3"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Tabbed Collections Premium"
    }
  ]
}
{% endschema %}
