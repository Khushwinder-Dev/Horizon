                  <span class="bundle-product-cards__button-text">Add {{ bundle_title | escape }} bundle to cart</span>
                </button>
              {% endif %}
            </div>

            <div class="bundle-product-cards__body">
              <h3 class="bundle-product-cards__title">{{ bundle_title }}</h3>
              {% if block.settings.bundle_subtitle != blank %}
                <p class="bundle-product-cards__subtitle-card">{{ block.settings.bundle_subtitle }}</p>
              {% endif %}
              <p class="bundle-product-cards__caption{% unless block.settings.show_caption %} bundle-product-cards__caption--hidden{% endunless %}">
                {{ bundle_caption }}
              </p>
              {% if has_products %}
                <div class="bundle-product-cards__footer">
                  <span class="bundle-product-cards__button-text">Select products to enable bundle</span>
                </div>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <script>
    (function () {
      var sectionId = 'bundle-product-cards-{{ section.id }}';
      var sectionElement = document.getElementById(sectionId);

      if (!sectionElement) {
        return;
      }

      sectionElement.addEventListener('click', function (event) {
        var button = event.target.closest('[data-bundle-add-button]');
        if (!button) {
          return;
        }

        event.preventDefault();
        if (button.disabled) {
          return;
        }

        var card = button.closest('[data-bundle-card]');
        if (!card) {
          return;
        }

        var variantId1 = parseInt(card.getAttribute('data-variant-id-1'), 10);
        var variantId2 = parseInt(card.getAttribute('data-variant-id-2'), 10);
        var bundleTitle = card.getAttribute('data-bundle-title') || 'bundle';

        if (!variantId1 || !variantId2) {
          console.error('Bundle Product Cards: missing variant for', bundleTitle);
          return;
        }

        button.disabled = true;
        button.classList.add('bundle-product-cards__button--loading');

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            items: [
              { id: variantId1, quantity: 1 },
              { id: variantId2, quantity: 1 }
            ]
          })
        })
          .then(function (response) {
            if (!response.ok) {
              return response.json().then(function (error) {
                throw error;
              });
            }
            return response.json();
          })
          .then(function () {
            window.location.href = '/cart';
          })
          .catch(function (error) {
            console.error('Bundle Product Cards: add to cart failed', error);
          })
          .finally(function () {
            button.disabled = false;
            button.classList.remove('bundle-product-cards__button--loading');
          });
      });
    })();
  </script>

  {% schema %}
  {
    "name": "Bundle Product Cards",
    "tag": "section",
    "class": "bundle-product-cards",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "checkbox",
        "id": "show_heading",
        "label": "Show heading",
        "default": true
      },
      {
        "type": "text",
        "id": "heading_text",
        "label": "Heading text",
        "default": "Everyday Comfort Combo for Mom"
      },
      {
        "type": "textarea",
        "id": "heading_subtitle",
        "label": "Section subtitle",
        "default": "Support her everyday comfort with curated bundles that deliver relief and posture support."
      },
      {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ],
        "default": "left"
      }
    ],
    "blocks": [
      {
        "type": "bundle_card",
        "name": "Bundle card",
        "settings": [
          {
            "type": "image_picker",
            "id": "bundle_image",
            "label": "Bundle image"
          },
          {
            "type": "text",
            "id": "bundle_title",
            "label": "Bundle title",
            "default": "Bundle title"
          },
          {
            "type": "text",
            "id": "bundle_subtitle",
            "label": "Bundle subtitle",
            "default": "Supports posture and comfort"
          },
          {
            "type": "textarea",
            "id": "bundle_caption",
            "label": "Caption text",
            "default": "Support your daily comfort with this carefully selected bundle."
          },
          {
            "type": "checkbox",
            "id": "show_caption",
            "label": "Show caption",
            "default": true
          },
          {
            "type": "product",
            "id": "product_1",
            "label": "Product 1"
          },
          {
            "type": "product",
            "id": "product_2",
            "label": "Product 2"
          },
          {
            "type": "checkbox",
            "id": "enabled",
            "label": "Enable bundle card",
            "default": true
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Bundle Product Cards",
        "category": "Products",
        "blocks": [
          {
            "type": "bundle_card",
            "settings": {
              "bundle_title": "Back Support + Posture Corrector",
              "bundle_caption": "Relieves pain and improves posture for all-day comfort.",
              "show_caption": true
            }
          },
          {
            "type": "bundle_card",
            "settings": {
              "bundle_title": "Posture Corrector + Shoulder Brace",
              "bundle_caption": "Improves posture while stabilizing shoulders.",
              "show_caption": true
            }
          },
          {
            "type": "bundle_card",
            "settings": {
              "bundle_title": "Full Back Support + Lumbar Belt",
              "bundle_caption": "Maximum support for lower and upper back relief.",
              "show_caption": true
            }
          }
        ]
      }
    ]
  }
  {% endschema %}
</section>
