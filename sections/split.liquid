{% comment %}
  Section: Split Feature Banner (Image + Content Card)
  File: split-feature-banner.liquid
  Notes:
  - Single-file Shopify section (no snippets).
  - Mobile-first: stacks, then desktop two-column like screenshot.
  - Tons of settings for spacing, widths, offsets, typography, button styling.
{% endcomment %}

{% style %}
  .sfb-{{ section.id }}{
    background: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.pad_top_m }}px;
    padding-bottom: {{ section.settings.pad_bot_m }}px;
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }}{
      padding-top: {{ section.settings.pad_top_d }}px;
      padding-bottom: {{ section.settings.pad_bot_d }}px;
    }
  }

  .sfb-{{ section.id }} .sfb__wrap{
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.side_pad_m }}px;
    padding-right: {{ section.settings.side_pad_m }}px;
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__wrap{
      padding-left: {{ section.settings.side_pad_d }}px;
      padding-right: {{ section.settings.side_pad_d }}px;
    }
  }

  /* Main pink container */
  .sfb-{{ section.id }} .sfb__container{
    background: {{ section.settings.container_bg }};
    border: {{ section.settings.container_border_w }}px solid {{ section.settings.container_border }};
    border-radius: {{ section.settings.container_radius }}px;
    box-shadow: {% if section.settings.container_shadow %} 0 18px 50px rgba(0,0,0,0.10) {% else %} none {% endif %};
    padding: {{ section.settings.container_pad_m }}px;
    overflow: visible; /* UPDATED: allow image to overflow outside like reference */
    transform: translate({{ section.settings.container_x_m }}px, {{ section.settings.container_y_m }}px);
    position: relative; /* UPDATED */
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__container{
      padding: {{ section.settings.container_pad_d }}px;
      transform: translate({{ section.settings.container_x_d }}px, {{ section.settings.container_y_d }}px);
    }
  }

  .sfb-{{ section.id }} .sfb__grid{
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.gap_m }}px;
    align-items: center;
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__grid{
      grid-template-columns: {{ section.settings.image_col_w_d }}% {{ section.settings.content_col_w_d }}%;
      gap: {{ section.settings.gap_d }}px;
      align-items: center;
    }
  }

  /* Image card */
  .sfb-{{ section.id }} .sfb__media{
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: {{ section.settings.image_bg }};
    box-shadow: {% if section.settings.image_shadow %} 0 18px 45px rgba(0,0,0,0.20) {% else %} none {% endif %};
    transform: translate({{ section.settings.image_x_m }}px, {{ section.settings.image_y_m }}px);
    position: relative; /* UPDATED */
    z-index: 2; /* UPDATED: keep image above container */
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__media{
      transform: translate({{ section.settings.image_x_d }}px, {{ section.settings.image_y_d }}px);
    }
  }

  .sfb-{{ section.id }} .sfb__mediaInner{
    position: relative;
    width: 100%;
    height: {{ section.settings.image_h_m }}px;
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__mediaInner{
      height: {{ section.settings.image_h_d }}px;
    }
  }

  .sfb-{{ section.id }} .sfb__mediaInner img{
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_pos }};
    display: block;
    transform: scale({{ section.settings.image_scale | divided_by: 100.0 }});
  }

  /* Optional overlay text on image (like the logo in screenshot) */
  .sfb-{{ section.id }} .sfb__overlay{
    position: absolute;
    inset: 0;
    display: {% if section.settings.overlay_enable %}flex{% else %}none{% endif %};
    align-items: {{ section.settings.overlay_v }};
    justify-content: {{ section.settings.overlay_h }};
    padding: {{ section.settings.overlay_pad_m }}px;
    pointer-events: none;
    transform: translate({{ section.settings.overlay_x_m }}px, {{ section.settings.overlay_y_m }}px);
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__overlay{
      padding: {{ section.settings.overlay_pad_d }}px;
      transform: translate({{ section.settings.overlay_x_d }}px, {{ section.settings.overlay_y_d }}px);
    }
  }

  .sfb-{{ section.id }} .sfb__overlayText{
    color: {{ section.settings.overlay_color }};
    font-size: {{ section.settings.overlay_fs_m }}px;
    font-weight: {{ section.settings.overlay_fw }};
    letter-spacing: {{ section.settings.overlay_ls }}px;
    text-align: {{ section.settings.overlay_text_align }};
    text-transform: {{ section.settings.overlay_case }};
    text-shadow: 0 12px 30px rgba(0,0,0,0.35);
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    max-width: {{ section.settings.overlay_max_w }}px;
    line-height: 1.05;
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__overlayText{
      font-size: {{ section.settings.overlay_fs_d }}px;
    }
  }

  /* Content area */
  .sfb-{{ section.id }} .sfb__content{
    max-width: {{ section.settings.content_max_w }}px;
    margin-left: {% if section.settings.content_align == 'left' %}0{% elsif section.settings.content_align == 'center' %}auto{% else %}auto{% endif %};
    margin-right: {% if section.settings.content_align == 'right' %}0{% elsif section.settings.content_align == 'center' %}auto{% else %}auto{% endif %};
    text-align: {{ section.settings.content_text_align }};
    transform: translate({{ section.settings.content_x_m }}px, {{ section.settings.content_y_m }}px);
    position: relative;
    z-index: 1;
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__content{
      transform: translate({{ section.settings.content_x_d }}px, {{ section.settings.content_y_d }}px);
    }
  }

  .sfb-{{ section.id }} .sfb__heading{
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_fs_m }}px;
    line-height: 1.15;
    font-weight: {{ section.settings.heading_fw }};
    letter-spacing: {{ section.settings.heading_ls }}px;
    transform: translate({{ section.settings.heading_x_m }}px, {{ section.settings.heading_y_m }}px);
    font-family: "New York", ui-serif, "Times New Roman", Times, serif;
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__heading{
      font-size: {{ section.settings.heading_fs_d }}px;
      transform: translate({{ section.settings.heading_x_d }}px, {{ section.settings.heading_y_d }}px);
      font-family: "New York", ui-serif, "Times New Roman", Times, serif;
    }
  }

  .sfb-{{ section.id }} .sfb__body{
    margin-top: {{ section.settings.body_mt_m }}px;
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.body_fs_m }}px;
    line-height: {{ section.settings.body_lh | divided_by: 100.0 }};
    font-weight: {{ section.settings.body_fw }};
    transform: translate({{ section.settings.body_x_m }}px, {{ section.settings.body_y_m }}px);
    font-family: "New York", ui-serif, "Times New Roman", Times, serif;
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__body{
      margin-top: {{ section.settings.body_mt_d }}px;
      font-size: {{ section.settings.body_fs_d }}px;
      transform: translate({{ section.settings.body_x_d }}px, {{ section.settings.body_y_d }}px);
      font-family: "New York", ui-serif, "Times New Roman", Times, serif;
    }
  }

  .sfb-{{ section.id }} .sfb__ctaWrap{
    margin-top: {{ section.settings.cta_mt_m }}px;
    transform: translate({{ section.settings.cta_x_m }}px, {{ section.settings.cta_y_m }}px);
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__ctaWrap{
      margin-top: {{ section.settings.cta_mt_d }}px;
      transform: translate({{ section.settings.cta_x_d }}px, {{ section.settings.cta_y_d }}px);
    }
  }

  .sfb-{{ section.id }} .sfb__btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    border-radius: {{ section.settings.btn_radius }}px;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_color }};
    border: {{ section.settings.btn_border_w }}px solid {{ section.settings.btn_border }};
    min-height: {{ section.settings.btn_h_m }}px;
    padding: 0 {{ section.settings.btn_px_m }}px;
    font-size: {{ section.settings.btn_fs_m }}px;
    font-weight: {{ section.settings.btn_fw }};
    letter-spacing: {{ section.settings.btn_ls }}px;
    box-shadow: {% if section.settings.btn_shadow %} 0 14px 40px rgba(0,0,0,0.12) {% else %} none {% endif %};
    transition: transform .15s ease, opacity .15s ease, background .15s ease, color .15s ease, border-color .15s ease;
  }
  @media (min-width: 750px){
    .sfb-{{ section.id }} .sfb__btn{
      min-height: {{ section.settings.btn_h_d }}px;
      padding: 0 {{ section.settings.btn_px_d }}px;
      font-size: {{ section.settings.btn_fs_d }}px;
    }
  }
  .sfb-{{ section.id }} .sfb__btn:hover{
    background: {{ section.settings.btn_bg_hover }};
    color: {{ section.settings.btn_color_hover }};
    border-color: {{ section.settings.btn_border_hover }};
    opacity: {{ section.settings.btn_hover_opacity | divided_by: 100.0 }};
  }
  .sfb-{{ section.id }} .sfb__btn:active{
    transform: scale(0.99);
  }

  /* a11y helper (if theme missing) */
  .sfb-{{ section.id }} .visually-hidden{
    position:absolute !important;
    height:1px; width:1px;
    overflow:hidden;
    clip:rect(1px, 1px, 1px, 1px);
    white-space:nowrap;
  }
{% endstyle %}

<section class="sfb-{{ section.id }}" aria-label="Split feature banner">
  <div class="sfb__wrap">
    <div class="sfb__container">
      <div class="sfb__grid">

        <div class="sfb__media">
          <div class="sfb__mediaInner">
            {% if section.settings.image != blank %}
              {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
            {% endif %}

            <div class="sfb__overlay" aria-hidden="true">
              {% if section.settings.overlay_text != blank %}
                <div class="sfb__overlayText">{{ section.settings.overlay_text }}</div>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="sfb__content">
          {% if section.settings.heading != blank %}
            <h2 class="sfb__heading">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.body != blank %}
            <div class="sfb__body">{{ section.settings.body }}</div>
          {% endif %}

          {% if section.settings.btn_label != blank and section.settings.btn_link != blank %}
            <div class="sfb__ctaWrap">
              <a class="sfb__btn" href="{{ section.settings.btn_link }}">
                {{ section.settings.btn_label }}
              </a>
            </div>
          {% endif %}
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
