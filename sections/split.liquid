    { "type": "checkbox", "id": "container_shadow", "label": "Container shadow", "default": false },
    { "type": "range", "id": "container_pad_m", "label": "Container padding (mobile)", "min": 10, "max": 80, "step": 2, "default": 18 },
    { "type": "range", "id": "container_pad_d", "label": "Container padding (desktop)", "min": 10, "max": 120, "step": 2, "default": 26 },

